{
  "name": "Piano Ufficio — Open Space e Sale Riunioni",
  "description": "Open space con sei persone. Tre sale riunioni isolate. La perception layer modella correttamente che le conversazioni in sala non si sentono dal corridoio (raggio sonoro 8m). Mostra come la stessa simulazione, senza scrivere logica di stanze, riproduce il comportamento delle 'rooms' grazie alla geografia + sensi.",
  "maxTicks": 30,
  "tickIntervalMs": 1000,
  "interaction": {
    "mode": "perception",
    "disableBroadcastFallback": true,
    "topicWindowTicks": 6,
    "defaultNeedsTemplate": "humanBasic",
    "sharedVenueLabels": ["corridoio", "open-space", "atrio"],
    "defaultSenses": [
      { "channel": "sound", "radiusKm": 0.008 },
      { "channel": "sight", "radiusKm": 0.015 },
      { "channel": "language", "languages": ["it", "en"] }
    ]
  },
